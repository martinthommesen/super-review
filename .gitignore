# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.uv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local env files (none are required; see .env.example)
.env
.env.*
!.env.example

# Build output
dist/*
!dist/.gitkeep

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Local Cursor hook state (committed project hooks under .cursor/hooks/ are allowed;
# only generated state/logs are ignored)
.cursor/hooks/state/
.cursor/hooks/**/*.log

# Local Claude Code overrides (committed .claude/settings.json keeps shared hooks)
.claude/settings.local.json

# Local review output
FINDINGS.md
